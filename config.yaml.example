aws_region:        "us-east-1"
availability_zone: "us-east-1a"

vpc_cidr:         "172.31.0.0/16"
wan_subnet_cidr:  "172.31.0.0/20"   # Public  – pfSense WAN interface
lan_subnet_cidr:  "172.31.254.0/24" # Private – pfSense LAN interface + Ubuntu server

pfsense_lan_ip:    "172.31.254.10"  # pfSense LAN ENI IP (default gateway for LAN hosts)
ubuntu_private_ip: "172.31.254.20"  # Ubuntu server static IP

ami_id:            "ami-0dcd87fd64421d7e1"  # pfSense-plus-ec2-25.11.1
ubuntu_ami_id:     "ami-0e2c8caa4b6378d8c"  # Ubuntu 24.04 LTS (us-east-1) – update if needed
instance_type: "t3.small"
key_name: "pfsense-key" # Name of the EC2 Key Pair to create in AWS; the private key will be saved as <key_name>.pem

admin_ip: "YOUR_PUBLIC_IP/32" # Your public IP – restrict SSH/HTTPS management access to pfSense
