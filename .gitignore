# Terraform state
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Generated private keys
*.pem

# AWS credentials — never commit
secrets.yaml

# Runtime config — contains your public IP and other environment-specific values
# Copy config.yaml.example to config.yaml and fill in your values
config.yaml

# VPN config — contains Twilio peer IPs and VPN prefixes
# Copy vpn_config.yaml.example to vpn_config.yaml and fill in your values
vpn_config.yaml

# Ansible
ansible/collections/
ansible/group_vars/pfsense/vault.yml
# Generated by generate_inventory.sh; contains the pfSense public IP
ansible/inventory.ini
